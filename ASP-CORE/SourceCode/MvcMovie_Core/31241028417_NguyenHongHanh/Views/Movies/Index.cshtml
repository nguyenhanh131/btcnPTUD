@model IEnumerable<_31241028417_NguyenHongHanh.Models.Movie>
@{
    ViewData["Title"] = "Trang chủ";
    var genres = (List<_31241028417_NguyenHongHanh.Models.Genre>)ViewBag.Genres;
    int? selected = ViewBag.SelectedGenre;
}

<section class="hero rounded text-white p-4 p-md-5 mb-4">
    <h1 class="display-5 font-weight-bold">Kho phim chọn lọc</h1>
    <p class="lead mb-3">Chọn phim yêu thích, thêm vào giỏ và thanh toán chỉ trong vài bước.</p>
    <a href="#san-pham" class="btn btn-warning btn-lg">Xem sản phẩm</a>
</section>

<div id="san-pham" class="d-flex flex-wrap mb-4">
    <a asp-action="Index" class="btn btn-sm mr-2 mb-2 @(selected == null ? "btn-dark" : "btn-outline-dark")">Tất cả</a>
    @foreach (var g in genres)
    {
        <a asp-action="Index" asp-route-genreId="@g.ID"
           class="btn btn-sm mr-2 mb-2 @(selected == g.ID ? "btn-dark" : "btn-outline-dark")">@g.Name</a>
    }
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <p class="lead">Chưa có sản phẩm nào trong mục này.</p>
        <a asp-action="Index" class="btn btn-outline-primary">Xem tất cả sản phẩm</a>
    </div>
}

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-6 col-md-4 col-lg-3 mb-4">
            <div class="card product-card h-100 shadow-sm">
                <a asp-action="Details" asp-route-id="@item.ID">
                    <img class="card-img-top" src="@item.PicturePath" alt="@item.Title"
                         style="height:240px; object-fit:cover;" />
                </a>
                <div class="card-body d-flex flex-column">
                    <small class="text-muted">@(item.GenreObj?.Name ?? "Chưa phân loại")</small>
                    <h5 class="card-title mt-1">
                        <a asp-action="Details" asp-route-id="@item.ID" class="text-dark">@item.Title</a>
                    </h5>
                    <div class="text-warning small mb-1">@(new string('★', (int)item.Rated))</div>                    <p class="font-weight-bold text-danger mb-2">@item.Price.ToString("N0") đ</p>
                    <div class="mt-auto">
                        <a asp-action="AddToCart" asp-route-id="@item.ID" class="btn btn-primary btn-block btn-sm">
                            Thêm vào giỏ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>