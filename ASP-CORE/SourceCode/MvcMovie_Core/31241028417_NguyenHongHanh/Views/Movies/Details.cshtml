@model _31241028417_NguyenHongHanh.Models.Movie
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb bg-transparent px-0">
        <li class="breadcrumb-item"><a asp-action="Index">Sản phẩm</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="row">
    <div class="col-md-5 mb-4">
        <img class="img-fluid rounded shadow-sm" src="@Model.PicturePath" alt="@Model.Title" />
    </div>
    <div class="col-md-7">
        <h2>@Model.Title</h2>
        <p class="text-muted mb-1">Thể loại: @(Model.GenreObj?.Name ?? "Chưa phân loại")</p>
        <p class="text-warning mb-2">@(new string('★', (int)Model.Rated))</p>
        <p class="h3 text-danger mb-3">@Model.Price.ToString("N0") đ</p>
        <p>@Model.Summary</p>
        <p class="small text-muted">Ngày phát hành: @Model.ReleaseDate.ToString("dd/MM/yyyy")</p>

        <div class="mt-4">
            <a asp-action="AddToCart" asp-route-id="@Model.ID" class="btn btn-primary btn-lg">Thêm vào giỏ</a>
            <a asp-action="Index" class="btn btn-outline-secondary btn-lg ml-2">Tiếp tục mua sắm</a>
        </div>
    </div>
</div>